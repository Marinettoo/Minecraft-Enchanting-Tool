# Configuración local del backend. Copiar como .env y completar los campos vacíos.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
AI_TIMEOUT_SECONDS=60

# Configuración de la aplicación de Clerk.
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Dejar vacío si la sesión no utiliza audiencia.
CLERK_AUDIENCE=

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
