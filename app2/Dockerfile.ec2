FROM node:24-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/index.html frontend/vite.config.js ./
COPY frontend/src/ ./src/
ARG VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY} VITE_API_URL=""
RUN test -n "$VITE_CLERK_PUBLISHABLE_KEY" && npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --uid 10001 --create-home appuser
COPY --chown=appuser:appuser backend/app/ ./app/
COPY --from=frontend /build/dist/ ./frontend/
USER appuser
EXPOSE 8443
CMD ["uvicorn", "app.web:create_web_app", "--factory", "--host", "0.0.0.0", "--port", "8443", "--ssl-certfile", "/run/tls/fullchain.pem", "--ssl-keyfile", "/run/tls/privkey.pem", "--no-access-log"]
