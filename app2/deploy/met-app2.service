[Unit]
Description=Actualizar y arrancar MeT App2 desde GitHub
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/practicas-aws/Minecraft-Enchanting-Tool/app2
ExecStart=/usr/local/bin/met-app2-update
Environment=HOME=/home/ubuntu
Environment=GIT_TERMINAL_PROMPT=0
UMask=0077
TimeoutStartSec=1800
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
